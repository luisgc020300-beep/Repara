rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    // Documentos/fotos de una casa -- solo sus miembros pueden leer o subir,
    // comprobado contra el mismo documento de Firestore que ya gobierna el
    // acceso a los datos de esa casa (casas/{casaId}.members).
    match /casas/{casaId}/{allPaths=**} {
      allow read, write: if request.auth != null &&
          request.auth.uid in firestore.get(/databases/(default)/documents/casas/$(casaId)).data.members;
    }
  }
}
