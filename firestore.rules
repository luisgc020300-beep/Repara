rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ── Helpers ──────────────────────────────────────────────────────────────
    function isAuth()     { return request.auth != null; }
    function isOwner(uid) { return request.auth.uid == uid; }
    function isMember(cid) {
      return request.auth.uid in
          get(/databases/$(database)/documents/casas/$(cid)).data.members;
    }

    // ── users ────────────────────────────────────────────────────────────────
    match /users/{uid} {
      allow read, write: if isAuth() && isOwner(uid);
    }

    // ── profesionales (perfil profesional, sección 17 del spec) ────────────────
    // Solo el propio profesional lee/escribe su ficha -- el propietario nunca
    // la consulta directamente, solo a través de invitarProfesional (Cloud
    // Function con Admin SDK, que no pasa por estas reglas).
    match /profesionales/{uid} {
      allow read, write: if isAuth() && isOwner(uid);
    }

    // ── invitaciones (propietario invita a un profesional a UN trabajo) ────────
    match /invitaciones/{iid} {
      allow read: if isAuth() && (resource.data.propietarioUid == request.auth.uid || resource.data.profesionalUid == request.auth.uid);
      // Solo se crean vía Cloud Function (invitarProfesional), que valida
      // pertenencia a la casa y que el email corresponde a un profesional
      // real -- el cliente nunca crea esto directamente.
      allow create: if false;
      // El profesional invitado puede aceptar/rechazar -- nada más.
      allow update: if isAuth() && resource.data.profesionalUid == request.auth.uid
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['estado']);
      allow delete: if false;
    }

    // ── casas ────────────────────────────────────────────────────────────────
    match /casas/{cid} {
      allow read: if isAuth() && request.auth.uid in resource.data.members;
      // joinCode y members se mutan vía Cloud Function transaccional
      // (createCasa/joinCasa) -- nunca con un create/update directo del
      // cliente. El nombre es la única excepción: cualquier miembro puede
      // renombrar la casa sin pasar por una función, no es un dato sensible.
      allow create: if false;
      allow update: if isAuth() && isMember(cid)
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['nombre']);

      match /habitaciones/{hid} {
        allow read, write: if isAuth() && isMember(cid);
      }

      match /elementos/{eid} {
        allow read, write: if isAuth() && isMember(cid);
      }

      // Libreta privada de profesionales de confianza de la casa -- nunca
      // visible fuera de sus miembros, no es un listado público.
      match /contactos/{ctid} {
        allow read, write: if isAuth() && isMember(cid);
      }

      // La historia de la casa (sección 12 del spec de producto) -- de
      // momento editable por cualquier miembro para poder corregir errores;
      // el endurecimiento a append-only con auditoría (sección 46) queda
      // para cuando haya más de un miembro real por casa.
      match /eventos/{evid} {
        allow read, write: if isAuth() && isMember(cid);
      }

      // Un documento es visible/gestionable por los miembros de la casa como
      // siempre. Si además está ligado a un trabajo concreto (trabajoId), el
      // profesional asignado a ESE trabajo también puede verlo y añadir
      // documentos nuevos a él -- nunca a documentos de otras habitaciones o
      // sin relación con su trabajo (sección 24 del spec: acceso específico,
      // nunca a todos los documentos de la casa).
      match /documentos/{did} {
        allow read: if isAuth() && (
          isMember(cid) ||
          (resource.data.trabajoId != null &&
           get(/databases/$(database)/documents/casas/$(cid)/trabajos/$(resource.data.trabajoId)).data.profesionalUid == request.auth.uid)
        );
        allow create: if isAuth() && (
          isMember(cid) ||
          (request.resource.data.trabajoId != null &&
           get(/databases/$(database)/documents/casas/$(cid)/trabajos/$(request.resource.data.trabajoId)).data.profesionalUid == request.auth.uid)
        );
        allow update, delete: if isAuth() && isMember(cid);
      }

      // Un trabajo es visible/editable por los miembros de la casa como
      // siempre, y ADEMÁS por el profesional asignado en profesionalUid (si
      // lo hay) -- ese profesional no es miembro de la casa, así que esto es
      // una segunda vía de acceso, no una sustitución de isMember(). Su
      // escritura queda limitada a estado/presupuesto: nunca puede cambiar el
      // título, la descripción ni reasignarse a sí mismo otro trabajo.
      match /trabajos/{tid} {
        allow read: if isAuth() && (isMember(cid) || resource.data.profesionalUid == request.auth.uid);
        allow create: if isAuth() && isMember(cid);
        // profesionalUid NUNCA es escribible por un miembro -- solo
        // responderInvitacion (Cloud Function, Admin SDK, salta estas
        // reglas) lo asigna, tras el apretón de manos de invitación y
        // aceptación. Sin esto, cualquier miembro podría escribir
        // directamente un uid ajeno en este campo y darle acceso al trabajo
        // sin pasar por invitar/aceptar -- hallazgo de la auditoría de
        // seguridad (octubre 2026).
        allow update: if isAuth() && (
          (isMember(cid) && !request.resource.data.diff(resource.data).affectedKeys().hasAny(['profesionalUid'])) ||
          (resource.data.profesionalUid == request.auth.uid &&
           request.resource.data.diff(resource.data).affectedKeys().hasOnly(['estado', 'presupuesto']))
        );
        allow delete: if isAuth() && isMember(cid);

        // Presupuestos formales (sección 15 del spec) -- toda escritura pasa
        // por Cloud Functions (crearPresupuesto, enviarPresupuesto,
        // responderPresupuesto...) para que los totales se calculen siempre
        // en servidor y nadie pueda autoaprobarse el suyo. El cliente solo
        // lee, y solo si es miembro de la casa o el profesional de ESE
        // trabajo concreto.
        match /presupuestos/{pid} {
          allow read: if isAuth() && (isMember(cid) || get(/databases/$(database)/documents/casas/$(cid)/trabajos/$(tid)).data.profesionalUid == request.auth.uid);
          allow write: if false;
        }

        // ScopeGuard -- cambios de alcance (sección 19 del spec). Misma
        // lógica: todo escrito por Cloud Functions, el cliente solo lee.
        match /cambiosAlcance/{caid} {
          allow read: if isAuth() && (isMember(cid) || get(/databases/$(database)/documents/casas/$(cid)/trabajos/$(tid)).data.profesionalUid == request.auth.uid);
          allow write: if false;
        }

        // Pagos registrados por el propietario contra el presupuesto del
        // trabajo. A diferencia de presupuestos/cambiosAlcance, aquí no hay
        // una aprobación entre dos partes que proteger -- solo el
        // propietario escribe sus propios pagos, directo desde el cliente.
        // El profesional asignado los lee con todo el detalle, pero nunca
        // puede crearlos, editarlos ni borrarlos.
        match /pagos/{pagoid} {
          allow read: if isAuth() && (isMember(cid) || get(/databases/$(database)/documents/casas/$(cid)/trabajos/$(tid)).data.profesionalUid == request.auth.uid);
          allow write: if isAuth() && isMember(cid);
        }
      }
    }

    // ── invitacionesAbiertas (código para profesionales sin cuenta todavía) ────
    // Nunca se lee ni se escribe directamente desde el cliente: se generan y
    // canjean solo a través de invitarProfesional/canjearCodigoInvitacion
    // (Cloud Functions con Admin SDK, que no pasan por estas reglas). Igual
    // que con "invitaciones", el propietario nunca consulta esto por su
    // cuenta -- el código se lo queda él mismo para compartirlo a mano.
    match /invitacionesAbiertas/{codigo} {
      allow read, write: if false;
    }

    // ── usoIA (límite diario de llamadas a la IA por usuario) ───────────────
    // Solo lo leen/escriben las Cloud Functions con Admin SDK -- el cliente
    // nunca necesita ni debe tocar su propio contador.
    match /usoIA/{id} {
      allow read, write: if false;
    }

    // ── notificaciones internas (sección 29 del spec) ───────────────────────
    // Las crean siempre las Cloud Functions (Admin SDK, no pasa por estas
    // reglas) -- el cliente solo lee las suyas y puede marcarlas como
    // leídas, nunca crear ni borrar ni tocar el contenido.
    match /notificaciones/{nid} {
      allow read: if isAuth() && resource.data.uid == request.auth.uid;
      allow update: if isAuth() && resource.data.uid == request.auth.uid
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['leida']);
      allow create, delete: if false;
    }
  }
}
