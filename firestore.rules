rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ── Helpers ──────────────────────────────────────────────────────────────
    function isAuth()     { return request.auth != null; }
    function isOwner(uid) { return request.auth.uid == uid; }
    function isMember(cid) {
      return request.auth.uid in
          get(/databases/$(database)/documents/casas/$(cid)).data.members;
    }
    // "terminado"/"archivado"/"pendienteConfirmacion"/"pendientePago" solo se
    // alcanzan (y solo se abandonan) a través de las Cloud Functions
    // finalizarTrabajoPropietario/marcarTrabajoFinalizadoProfesional/
    // rechazarFinalizacionProfesional/registrarPago/actualizarPago/
    // eliminarPago (Admin SDK, saltan estas reglas) -- nunca por una
    // escritura directa del cliente, porque esas funciones son las que
    // generan las notificaciones; una escritura directa los dejaría
    // "terminados" (o "pendientes") en silencio (auditoría de seguridad,
    // octubre 2026). No existe un evento de historial separado -- el propio
    // registro es el historial, igual que ya documenta
    // finalizarTrabajoPropietario en functions/index.js. Modelo de dos pasos:
    // pendienteConfirmacion tampoco es editable directamente en ninguna
    // dirección, para que ni el profesional pueda fingir que el propietario
    // ya confirmó, ni el propietario pueda saltarse rechazarFinalizacion
    // para "deshacer" la confirmación pendiente sin avisar al profesional.
    // pendientePago (CEO, octubre 2026): "terminado" exige trabajo Y pago --
    // solo las Cloud Functions de pagos pueden moverlo hacia o fuera de
    // aquí, nunca una escritura directa (p.ej. "marcarlo pagado" sin que de
    // verdad haya un pago que lo respalde).
    function estadoControlado(v) { return v == 'terminado' || v == 'archivado' || v == 'pendienteConfirmacion' || v == 'pendientePago'; }

    // ── users ────────────────────────────────────────────────────────────────
    match /users/{uid} {
      allow read, write: if isAuth() && isOwner(uid);
    }

    // ── profesionales (perfil profesional, sección 17 del spec) ────────────────
    // Solo el propio profesional lee/escribe su ficha -- el propietario nunca
    // la consulta directamente, solo a través de invitarProfesional (Cloud
    // Function con Admin SDK, que no pasa por estas reglas).
    match /profesionales/{uid} {
      allow read, write: if isAuth() && isOwner(uid);
    }

    // ── invitaciones (propietario invita a un profesional a UN trabajo) ────────
    match /invitaciones/{iid} {
      allow read: if isAuth() && (resource.data.propietarioUid == request.auth.uid || resource.data.profesionalUid == request.auth.uid);
      // Solo se crean vía Cloud Function (invitarProfesional), que valida
      // pertenencia a la casa y que el email corresponde a un profesional
      // real -- el cliente nunca crea esto directamente.
      allow create: if false;
      // El profesional invitado puede aceptar/rechazar -- nada más.
      allow update: if isAuth() && resource.data.profesionalUid == request.auth.uid
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['estado']);
      allow delete: if false;
    }

    // ── casas ────────────────────────────────────────────────────────────────
    match /casas/{cid} {
      allow read: if isAuth() && request.auth.uid in resource.data.members;
      // joinCode y members se mutan vía Cloud Function transaccional
      // (createCasa/joinCasa) -- nunca con un create/update directo del
      // cliente. El nombre es la única excepción: cualquier miembro puede
      // renombrar la casa sin pasar por una función, no es un dato sensible.
      allow create: if false;
      allow update: if isAuth() && isMember(cid)
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['nombre']);

      match /habitaciones/{hid} {
        allow read, write: if isAuth() && isMember(cid);
      }

      // Un elemento (objeto físico o servicio contratado -- fusión de lo
      // que antes eran Elemento y Trabajo, octubre 2026) nunca se abre a
      // profesionales: ellos solo acceden a SU registro concreto (ver
      // abajo), nunca al elemento padre -- por eso Registro denormaliza
      // elementoNombre, para que el lado Pro no necesite leer este doc.
      match /elementos/{eid} {
        allow read: if isAuth() && isMember(cid);
        // Archivar/restaurar (auditoría R5, octubre 2026) pasa por las
        // Cloud Functions archivarElemento/restaurarElemento porque decidir
        // si se puede archivar exige recorrer la subcolección de registros
        // de este elemento (¿hay trabajo profesional activo?), algo que
        // estas reglas no pueden comprobar -- igual que registrarPago, que
        // también pasó a Cloud Function por el mismo motivo (tener que leer
        // una colección entera, no solo un documento). El cliente puede
        // escribir cualquier otro campo del elemento directamente, pero
        // nunca estos tres -- igual que profesionalUid/presupuesto en
        // registros, abajo.
        allow create: if isAuth() && isMember(cid)
            && !('archivado' in request.resource.data)
            && !('archivadoAt' in request.resource.data)
            && !('archivadoPorUid' in request.resource.data);
        allow update: if isAuth() && isMember(cid)
            && !request.resource.data.diff(resource.data).affectedKeys().hasAny(['archivado', 'archivadoAt', 'archivadoPorUid']);
        // Eliminación directa DESHABILITADA (auditoría R6, octubre 2026):
        // borrar este documento nunca limpiaba sus subcolecciones
        // (registros, cambiosAlcance, presupuestos, pagos, historial) ni los
        // archivos de Storage asociados -- confirmado en R3/R4. El botón de
        // Flutter que la usaba ya no la llama (ver elemento_detail_screen.
        // dart), pero bloquearla aquí también es necesario: sin esto, una
        // llamada directa del cliente (saltándose la UI) seguiría pudiendo
        // borrar el documento igual que antes. Nunca se ha relajado ninguna
        // otra regla para compensar esto -- queda bloqueada hasta que exista
        // un proceso de eliminación seguro (ver informe de R4/R5/R6).
        allow delete: if false;

        // Un registro es cada suceso de un elemento -- fusión de lo que
        // antes eran Trabajo y Evento. Visible/editable por los miembros de
        // la casa como siempre, y ADEMÁS por el profesional asignado en
        // profesionalUid (si lo hay, solo cuando esConProfesional) -- ese
        // profesional no es miembro de la casa, así que esto es una
        // segunda vía de acceso, no una sustitución de isMember(). Su
        // escritura queda limitada a estado: nunca puede cambiar el
        // título, la descripción ni reasignarse a sí mismo otro registro.
        match /registros/{rid} {
          allow read: if isAuth() && (isMember(cid) || resource.data.profesionalUid == request.auth.uid);
          // profesionalUid tampoco es escribible EN LA CREACIÓN -- sin esto,
          // un miembro podría crear el registro ya con un profesionalUid
          // ajeno puesto, dándole acceso sin pasar por invitar/aceptar.
          //
          // A propósito NO se bloquea aquí estadoControlado(estado): una
          // compra o reforma sin profesional (nuevo_elemento_screen.dart)
          // crea su registro fundacional directamente como "terminado" --
          // no hay ningún profesional ni flujo de finalización que
          // saltarse, porque el registro nace y muere en el mismo estado,
          // sin pasos intermedios. Bloquearlo aquí (como se hizo en la
          // auditoría de seguridad de octubre 2026) impedía crear CUALQUIER
          // compra o nota simple -- un efecto secundario no buscado, no el
          // hueco que esa auditoría perseguía. La protección real sigue
          // intacta y es independiente de esto: "allow update" de abajo
          // (línea ~130) ya impide, por su cuenta, que estado ENTRE o SALGA
          // de un estado controlado en cualquier escritura posterior,
          // crear con profesionalUid sigue prohibido arriba, y nadie fuera
          // de isMember(cid) puede tocar nada de esta casa.
          // "Un elemento archivado no debe iniciar trabajo nuevo sin
          // restaurarse primero" (auditoría R5): un elemento solo se puede
          // archivar si ninguno de sus registros tiene trabajo profesional
          // activo (lo exige archivarElemento en servidor), así que, una vez
          // archivado, ya no debería poder nacer un registro nuevo bajo él
          // sin pasar primero por restaurarElemento.
          allow create: if isAuth() && isMember(cid)
              && !('profesionalUid' in request.resource.data)
              && !('presupuesto' in request.resource.data)
              && !('presupuestoAceptadoId' in request.resource.data)
              && get(/databases/$(database)/documents/casas/$(cid)/elementos/$(eid)).data.get('archivado', false) != true;
          // profesionalUid NUNCA es escribible por un miembro -- solo
          // responderInvitacion (Cloud Function, Admin SDK, salta estas
          // reglas) lo asigna, tras el apretón de manos de invitación y
          // aceptación. Sin esto, cualquier miembro podría escribir
          // directamente un uid ajeno en este campo y darle acceso al
          // registro sin pasar por invitar/aceptar.
          //
          // "presupuesto"/"presupuestoAceptadoId" tampoco son escribibles
          // directamente (segunda auditoría de integridad económica,
          // octubre 2026) -- antes solo lo decía el comentario, no la
          // regla: un miembro podía escribir "presupuesto" directo sin
          // pasar por ninguna Cloud Function, y nada impedía que
          // responderPresupuesto siguiera aceptando un segundo presupuesto
          // tras resetear "estado" a 'nuevo' con una escritura directa
          // (estado SÍ sigue siendo editable a propósito -- ver
          // "_estadosEditables" en registro_detail_screen.dart/
          // registro_pro_detail_screen.dart, es una función real para
          // marcar progreso a mano). Por eso la protección real ya no vive
          // en "estado" sino en "presupuestoAceptadoId", que
          // responderPresupuesto fija y que ningún cliente puede tocar ni
          // para ponerlo ni para borrarlo.
          //
          // Un miembro puede escribir cualquier otro campo, pero nunca
          // puede hacer que "estado" entre NI salga de un estado
          // controlado por esta vía (si ya estaba ahí y se queda igual, no
          // cuenta como transición -- permite editar otros campos sin
          // tocar estado). El profesional asignado solo puede tocar
          // "estado" -- nunca "presupuesto" directamente -- y tampoco
          // puede entrar ni salir de un estado controlado por esta vía.
          // "estadoPrevioAPendiente" tampoco es escribible por el
          // cliente -- es lo que usa rechazarFinalizacionProfesional para
          // saber a dónde volver.
          allow update: if isAuth() && (
            (isMember(cid) &&
             !request.resource.data.diff(resource.data).affectedKeys().hasAny(['profesionalUid', 'estadoPrevioAPendiente', 'presupuesto', 'presupuestoAceptadoId']) &&
             (resource.data.estado == request.resource.data.estado ||
              (!estadoControlado(resource.data.estado) && !estadoControlado(request.resource.data.estado)))) ||
            (resource.data.profesionalUid == request.auth.uid &&
             request.resource.data.diff(resource.data).affectedKeys().hasOnly(['estado']) &&
             (resource.data.estado == request.resource.data.estado ||
              (!estadoControlado(resource.data.estado) && !estadoControlado(request.resource.data.estado))))
          );
          // Eliminación directa DESHABILITADA (auditoría R8, octubre 2026):
          // mismo motivo que elementos/{eid} más arriba (R6) -- borrar este
          // documento nunca limpiaba su propia foto en Storage ni los
          // documentos (ni sus archivos) que lo referencian por registroId.
          // El menú de Flutter que la usaba ya no la llama (ver
          // registro_detail_screen.dart), pero bloquearla aquí también es
          // necesario: sin esto, una llamada directa del cliente
          // (saltándose la UI) seguiría pudiendo borrar el documento igual
          // que antes. eliminarCuenta sigue pudiendo borrar un registro
          // como parte de un recursiveDelete de la casa entera (Admin SDK,
          // salta estas reglas) -- confirmado que no hay ningún otro
          // consumidor legítimo de un borrado directo.
          allow delete: if false;

          // Presupuestos formales (sección 15 del spec) -- toda escritura
          // pasa por Cloud Functions (crearPresupuesto, enviarPresupuesto,
          // responderPresupuesto...) para que los totales se calculen
          // siempre en servidor y nadie pueda autoaprobarse el suyo. El
          // cliente solo lee, y solo si es miembro de la casa o el
          // profesional de ESE registro concreto.
          match /presupuestos/{pid} {
            allow read: if isAuth() && (isMember(cid) || get(/databases/$(database)/documents/casas/$(cid)/elementos/$(eid)/registros/$(rid)).data.profesionalUid == request.auth.uid);
            allow write: if false;
          }

          // ScopeGuard -- cambios de alcance (sección 19 del spec). Misma
          // lógica: todo escrito por Cloud Functions, el cliente solo lee.
          match /cambiosAlcance/{caid} {
            allow read: if isAuth() && (isMember(cid) || get(/databases/$(database)/documents/casas/$(cid)/elementos/$(eid)/registros/$(rid)).data.profesionalUid == request.auth.uid);
            allow write: if false;
          }

          // Pagos registrados por el propietario contra el presupuesto del
          // registro. El profesional asignado los lee con todo el detalle,
          // pero nunca puede crearlos, editarlos ni borrarlos.
          //
          // create/update pasan por Cloud Function (registrarPago/
          // actualizarPago, Admin SDK) desde la corrección DATA-1 de
          // integridad económica (octubre 2026) -- antes se escribían
          // directo desde el cliente, que comprobaba el total pagado contra
          // el presupuesto ANTES de escribir sin que lectura y escritura
          // fueran atómicas: dos pagos simultáneos (o un cliente manipulado
          // que se saltara la comprobación de la UI) podían sumar entre los
          // dos más que el presupuesto, porque esta regla solo validaba el
          // rango del importe individual, nunca la suma acumulada. Ahora esa
          // suma se valida en una transacción en servidor.
          // delete pasó a Cloud Function (eliminarPago) en la auditoría R8
          // (octubre 2026, hallazgo H4): el supuesto de que "borrar un pago
          // nunca puede hacer que la suma supere el presupuesto" dejó de ser
          // cierto en cuanto existió el archivado -- archivar exige que el
          // saldo esté cubierto EN ESE MOMENTO, y borrar un pago después
          // podía deshacer esa garantía en silencio, dejando un elemento
          // archivado con una deuda real. Firestore.rules no puede comprobar
          // eso (exige leer el presupuesto del registro, sumar el resto de
          // pagos y el estado archivado del elemento -- una agregación que
          // estas reglas no pueden hacer), así que, igual que
          // registrarPago/actualizarPago, esto necesitaba una Cloud
          // Function. Mismo criterio de autorización que tenía la regla
          // directa que sustituye (solo quien creó el pago puede borrarlo).
          match /pagos/{pagoid} {
            allow read: if isAuth() && (isMember(cid) || get(/databases/$(database)/documents/casas/$(cid)/elementos/$(eid)/registros/$(rid)).data.profesionalUid == request.auth.uid);
            allow write: if false;
          }

          // Historial append-only de presupuestos/cambiosAlcance/pagos
          // (auditoría de seguridad, octubre 2026) -- lo escriben solo las
          // Cloud Functions (Admin SDK, salta estas reglas) en cada
          // transición de estado real; el cliente nunca escribe aquí
          // directamente, ni siquiera el propietario. Mismo criterio de
          // lectura que presupuestos/cambiosAlcance: miembros de la casa o
          // el profesional de ESE registro concreto.
          match /historial/{hid} {
            allow read: if isAuth() && (isMember(cid) || get(/databases/$(database)/documents/casas/$(cid)/elementos/$(eid)/registros/$(rid)).data.profesionalUid == request.auth.uid);
            allow write: if false;
          }
        }
      }

      // Libreta privada de profesionales de confianza de la casa -- nunca
      // visible fuera de sus miembros, no es un listado público.
      match /contactos/{ctid} {
        allow read, write: if isAuth() && isMember(cid);
      }

      // Un documento es visible/gestionable por los miembros de la casa como
      // siempre. Si además está ligado a un registro concreto (registroId),
      // el profesional asignado a ESE registro también puede verlo y añadir
      // documentos nuevos a él -- nunca a documentos de otras habitaciones o
      // sin relación con su registro (sección 24 del spec: acceso
      // específico, nunca a todos los documentos de la casa).
      match /documentos/{did} {
        allow read: if isAuth() && (
          isMember(cid) ||
          (resource.data.registroId != null && resource.data.elementoId != null &&
           get(/databases/$(database)/documents/casas/$(cid)/elementos/$(resource.data.elementoId)/registros/$(resource.data.registroId)).data.profesionalUid == request.auth.uid)
        );
        allow create: if isAuth() && (
          isMember(cid) ||
          (request.resource.data.registroId != null && request.resource.data.elementoId != null &&
           get(/databases/$(database)/documents/casas/$(cid)/elementos/$(request.resource.data.elementoId)/registros/$(request.resource.data.registroId)).data.profesionalUid == request.auth.uid)
        );
        allow update, delete: if isAuth() && isMember(cid);
      }

      // Resumen de "pendientes" para el banner de Inicio (octubre 2026) --
      // un único documento mantenido por la Cloud Function
      // onRegistroEstadoCambiado, en vez de una consulta
      // collectionGroup('registros'). Se descartó el collection-group tras
      // validarlo contra el emulador: Firestore necesita poder demostrar
      // que la regla se cumple para TODA la colección, no solo para lo que
      // el filtro de la consulta devolvería -- con un registro de otra
      // casa que no cumple la regla para este propietario, deniega la
      // consulta entera aunque ese documento nunca fuera a aparecer en el
      // resultado. Un solo documento de solo lectura evita el problema
      // entero.
      match /resumen/{rid} {
        allow read: if isAuth() && isMember(cid);
        allow write: if false;
      }
    }

    // ── invitacionesAbiertas (código para profesionales sin cuenta todavía) ────
    // Nunca se lee ni se escribe directamente desde el cliente: se generan y
    // canjean solo a través de invitarProfesional/canjearCodigoInvitacion
    // (Cloud Functions con Admin SDK, que no pasan por estas reglas). Igual
    // que con "invitaciones", el propietario nunca consulta esto por su
    // cuenta -- el código se lo queda él mismo para compartirlo a mano.
    match /invitacionesAbiertas/{codigo} {
      allow read, write: if false;
    }

    // ── usoIA (límite diario de llamadas a la IA por usuario) ───────────────
    // Solo lo leen/escriben las Cloud Functions con Admin SDK -- el cliente
    // nunca necesita ni debe tocar su propio contador.
    match /usoIA/{id} {
      allow read, write: if false;
    }

    // ── intentosCodigo (límite de fuerza bruta en canjeo de códigos) ────────
    // Solo lo leen/escriben las Cloud Functions con Admin SDK.
    match /intentosCodigo/{id} {
      allow read, write: if false;
    }

    // ── notificaciones internas (sección 29 del spec) ───────────────────────
    // Las crean siempre las Cloud Functions (Admin SDK, no pasa por estas
    // reglas) -- el cliente solo lee las suyas y puede marcarlas como
    // leídas, nunca crear ni borrar ni tocar el contenido.
    match /notificaciones/{nid} {
      allow read: if isAuth() && resource.data.uid == request.auth.uid;
      allow update: if isAuth() && resource.data.uid == request.auth.uid
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['leida']);
      allow create, delete: if false;
    }
  }
}
